# Copy to .env for local development.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=convo_hub
PGUSER=convo_hub
PGPASSWORD=convo_hub_local

# Access token signing key. Provisioned per environment; there is no default.
JWT_SECRET=
JWT_ISSUER=convo-hub
JWT_AUDIENCE=convo-hub-api

# Outbound HTTP
LINK_PREVIEW_TIMEOUT_MS=4000

# Reporting
MAX_EXPORT_ROWS=5000
